---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="There is nothing at this address.">
  <section class="hero wrap">
    <p class="chip"><i class="pulse" aria-hidden="true"></i>404 · Not found</p>
    <h1 class="h-display">
      Nothing at this address. <span class="dim">The link may be old or mistyped.</span>
    </h1>
    <div class="actions">
      <a class="btn btn-accent" href="/">Back to home</a>
      <a class="btn" href="/#work">See the work</a>
    </div>
  </section>
</Base>
